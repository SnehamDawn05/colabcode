# ── PostgreSQL Database ─────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=colab_code
POSTGRES_PORT=5432

# ── Better Auth Secret ──────────────────────────────────────
AUTH_SECRET=colab-code-super-secret-key-32-characters-minimum-auth

# ── URLs (for browser access) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# ── Service Ports (host bindings) ───────────────────────────
WEB_PORT=3000
REALTIME_PORT=3001

# ── Optional OAuth ──────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
