# Database
DATABASE_URL=postgresql://user:password@localhost:5432/colab_code

# Better Auth
AUTH_SECRET=your-secret-key-here-min-32-chars-long

# OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Realtime Server
REALTIME_PORT=3001
NODE_ENV=development

# Session
SESSION_SECRET=your-session-secret-min-32-chars-long
